{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "LOGS_API_URL",
    "LOGS_API_KEY",
    "ADMIN_SESSION_COOKIE",
    "ADMIN_SESSION_MAX_AGE_SECONDS",
    "ADMIN_ALLOWED_EMAIL_DOMAIN",
    "BIBLIA_INTERNAL_INGESTION_KEY",
    "CALENDARIO_API_URL",
    "PUBLIC_PORTAL_WHATSAPP_NUMBER",
    "RESEND_API_KEY",
    "FEEDBACK_EMAIL_TO",
    "EXPO_PUBLIC_API_BASE_URL",
    "EXPO_PUBLIC_DEMO_USER_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".vercel/output/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test:unit": {
      "dependsOn": ["^test:unit"],
      "outputs": ["coverage/**"]
    },
    "mobile-buscador#test:unit": {
      "outputs": []
    },
    "mobile-cancionero#test:unit": {
      "outputs": []
    },
    "mobile-chatbot#test:unit": {
      "outputs": []
    },
    "mobile-donaciónes#test:unit": {
      "outputs": []
    },
    "mobile-emprendedor#test:unit": {
      "outputs": []
    },
    "mobile-formación#test:unit": {
      "outputs": []
    },
    "mobile-lectio-divina#test:unit": {
      "outputs": []
    },
    "mobile-meditvoz#test:unit": {
      "outputs": []
    },
    "mobile-motus#test:unit": {
      "outputs": []
    },
    "mobile-peticionario#test:unit": {
      "outputs": []
    },
    "@repo/mobile-auth-client#test:unit": {
      "outputs": []
    },
    "biblia-desktop#test:unit": {
      "outputs": []
    },
    "lectio-divina-desktop#test:unit": {
      "outputs": []
    },
    "fosforo-desktop#test:unit": {
      "outputs": []
    },
    "admin-parroquial-desktop#test:unit": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
