{
  "name": "fosforo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test:unit": "turbo run test:unit",
    "db:scripts:validate": "node db/scripts/validate.js",
    "db:link": "node db/scripts/supabase-cli.js link",
    "db:migrate": "node db/scripts/supabase-cli.js migrate",
    "db:push": "node db/scripts/supabase-cli.js push",
    "db:reset": "node db/scripts/supabase-cli.js reset",
    "db:seed": "node db/scripts/supabase-cli.js seed",
    "db:generate-types": "node db/scripts/supabase-cli.js generate-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "docs:new-app": "node scripts/docs-new-app.mjs",
    "docs:sync-app-status": "node scripts/docs-sync-app-status.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@vitest/coverage-v8": "catalog:",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tslib": "2.8.1",
    "turbo": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.21",
      "svgo": ">=4.0.2",
      "@babel/core": "7.29.7",
      "brace-expansion@>=3.0.0": ">=5.0.9"
    },
    "packageExtensions": {
      "@tailwindcss/cli@*": {
        "dependencies": {
          "mri": "^1.2.0"
        }
      }
    },
    "onlyBuiltDependencies": [
      "electron"
    ],
    "patchedDependencies": {
      "@astrojs/internal-helpers@0.10.4": "patches/@astrojs__internal-helpers@0.10.4.patch"
    }
  }
}
