# Fósforo - Environment Variables
# Copy this file to .env and fill in the values.
# These variables are shared across all apps via Vite envDir.

# Supabase (required for auth app and any DB-connected features)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Optional: separate key alias used by some modules
SUPABASE_KEY=

# Logs ingest (app log). URL del endpoint de ingesta y API key de la app emisora.
# Generar keys por app con: node db/scripts/generate-log-api-keys.js
LOGS_API_URL=
LOGS_API_KEY=

# Resend (email sending for feedback form, etc.)
RESEND_API_KEY=
FEEDBACK_EMAIL_TO=
