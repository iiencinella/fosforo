# Fósforo - Variables de Entorno
#
# Fuente de verdad: docs/01-Arquitectura/Capacidades Compartidas/Guia-Variables-de-Entorno.md
#
# Este archivo es la plantilla local. Copiar a .env (gitignored) y completar.
# Las variables compartidas se leen via @repo/env desde cualquier app.
# Para Vercel: configurar en Production/Preview del proyecto correspondiente
# y REDESPLEGAR para que apliquen.

# ---------------------------------------------------------------------------
# Supabase (compartido; requerido por biblia, calendario, cancionero,
# horarios, log, usuario y administracion)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Solo server. Requerida donde hay escrituras privilegiadas
# (cancionero, horarios, log, usuario, administracion)
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Logs compartidos (@repo/api-utils log-client; opcional:
# biblia, cancionero, portal, usuario degradan sin logging)
# ---------------------------------------------------------------------------
LOGS_API_URL=
LOGS_API_KEY=

# ---------------------------------------------------------------------------
# Administracion (solo app administracion)
# ---------------------------------------------------------------------------
ADMIN_SESSION_COOKIE=admin_session
ADMIN_SESSION_MAX_AGE_SECONDS=28800
ADMIN_ALLOWED_EMAIL_DOMAIN=

# ---------------------------------------------------------------------------
# Biblia
# ---------------------------------------------------------------------------
# Habilita la API interna de ingesta de biblia
BIBLIA_INTERNAL_INGESTION_KEY=

# ---------------------------------------------------------------------------
# Cancionero -> Calendario
# ---------------------------------------------------------------------------
# Base URL de la API de calendario; opcional, degrada sin tiempo liturgico
CALENDARIO_API_URL=

# ---------------------------------------------------------------------------
# Portal
# ---------------------------------------------------------------------------
PUBLIC_PORTAL_WHATSAPP_NUMBER=
RESEND_API_KEY=
FEEDBACK_EMAIL_TO=

# ---------------------------------------------------------------------------
# Mobile (futuro, Expo / @repo/mobile-auth-client)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_DEMO_USER_ID=

# ---------------------------------------------------------------------------
# SOLO LOCAL: CLI de Supabase y CI. No configurar en Vercel.
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# ALIAS DEPRECADOS - solo para transicion, no usar en codigo nuevo
# PUBLIC_SUPABASE_URL      -> SUPABASE_URL
# PUBLIC_SUPABASE_ANON_KEY -> SUPABASE_ANON_KEY
# SUPABASE_KEY             -> SUPABASE_ANON_KEY
# LOGS_INGEST_API_KEY      -> LOGS_API_KEY
