---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Recuperar contraseña - Usuarios Fósforo"
  description="Recuperación de acceso para usuarios del ecosistema Fósforo."
>
  <main>
    <section class="section">
      <div class="page form-center">
        <article class="card surface-card" style="max-width: 34rem;">
          <h1 class="section-title">Recuperar contraseña</h1>
            <p class="section-desc">
             Ingresá tu email para recibir un enlace de recuperación.
           </p>

           <form id="reset-form" class="form" novalidate>
            <div class="form-row">
              <label for="reset-email">Email</label>
              <input id="reset-email" name="email" type="email" autocomplete="email" required />
            </div>

             <div id="new-password-fields" hidden>
               <div class="form-row">
                 <label for="reset-password">Nueva contraseña</label>
                 <input id="reset-password" name="password" type="password" minlength="8" autocomplete="new-password" />
               </div>
               <div class="form-row">
                 <label for="reset-password-confirm">Repetir contraseña</label>
                 <input id="reset-password-confirm" name="passwordConfirm" type="password" minlength="8" autocomplete="new-password" />
               </div>
             </div>

             <button class="button-primary" type="submit" id="reset-submit">Enviar enlace</button>
            <p id="reset-status" class="form-status pending" role="status" aria-live="polite">
              Te enviaremos instrucciones por email.
            </p>
          </form>
        </article>
      </div>
    </section>
  </main>

  <script>
     const form = document.querySelector("#reset-form") as HTMLFormElement | null;
     const status = document.querySelector("#reset-status") as HTMLParagraphElement | null;
     const emailInput = document.querySelector("#reset-email") as HTMLInputElement | null;
     const passwordFields = document.querySelector("#new-password-fields") as HTMLElement | null;
     const submit = document.querySelector("#reset-submit") as HTMLButtonElement | null;

     const hash = new URLSearchParams(window.location.hash.slice(1));
     const recoveryToken = hash.get("access_token");
     const isRecovery = hash.get("type") === "recovery" && Boolean(recoveryToken);

     if (isRecovery && passwordFields && submit) {
       if (emailInput) {
         emailInput.required = false;
         emailInput.disabled = true;
         emailInput.closest(".form-row")?.setAttribute("hidden", "true");
       }
       passwordFields.hidden = false;
       submit.textContent = "Actualizar contraseña";
       status?.replaceChildren(document.createTextNode("Elegí una nueva contraseña."));
     }

    if (form && status) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();

         const formData = new FormData(form);
         const password = String(formData.get("password") || "");
         const passwordConfirm = String(formData.get("passwordConfirm") || "");

         if (isRecovery) {
           if (password.length < 8 || password !== passwordConfirm) {
             status.className = "form-status error";
             status.textContent = "Las contraseñas deben coincidir y tener al menos 8 caracteres.";
             return;
           }

           status.className = "form-status pending";
           status.textContent = "Actualizando contraseña...";

           try {
             const response = await fetch("/api/auth/update-password", {
               method: "POST",
               headers: {
                 "content-type": "application/json",
                 authorization: `Bearer ${recoveryToken}`,
               },
               body: JSON.stringify({ password }),
             });
             const data = await response.json();
             if (!response.ok || !data.ok) throw new Error("update_failed");
             window.history.replaceState({}, document.title, "/auth/reset-password");
             status.className = "form-status success";
             status.textContent = "Contraseña actualizada. Ya podés iniciar sesión.";
             form.reset();
           } catch {
             status.className = "form-status error";
             status.textContent = "No pudimos actualizar la contraseña. Solicita un nuevo enlace.";
           }
           return;
         }

         const payload = { email: String(formData.get("email") || "").trim() };

        status.className = "form-status pending";
        status.textContent = "Enviando solicitud...";

        try {
          const response = await fetch("/api/auth/reset-password", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(payload),
          });

          const data = await response.json();
          if (!response.ok || !data.ok) {
            throw new Error(data.error || "USERS_RESET_PASSWORD_FAILED");
          }

          status.className = "form-status success";
           status.textContent = "Si la cuenta existe, recibirás instrucciones por email.";
          form.reset();
         } catch {
           status.className = "form-status error";
           status.textContent = "No pudimos procesar la solicitud. Intentá nuevamente.";
        }
      });
    }
  </script>
</BaseLayout>
