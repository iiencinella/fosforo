# Fósforo - Environment Variables
# Copy this file to .env and fill in the values.
# These variables are shared across all apps via Vite envDir.

# Supabase (required for auth app and any DB-connected features)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Optional: separate key alias used by some modules
SUPABASE_KEY=

# Logs ingest API key (optional, falls back to SUPABASE_SERVICE_ROLE_KEY)
LOGS_INGEST_API_KEY=

# Logs API (para enviar logs al app log del ecosistema)
LOGS_API_URL=http://localhost:4321/api/logs
LOGS_API_KEY=fosforo-usuario-dev-key-2026

# Production: shared cookie domain for sibling apps
AUTH_COOKIE_DOMAIN=.fosforo.com.ar
