---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { requirePageAuth } from "@/lib/auth";
import {
  CELEBRATION_TYPE_LABELS,
  CELEBRATION_TYPES,
  WEEKDAY_INDEXES,
  WEEKDAY_LABELS,
} from "@/lib/mappers";
import { scheduleRowToUi } from "@/lib/validators";
import { supabase } from "@/db/supabase";

const auth = await requirePageAuth(Astro, ["admin", "editor", "viewer"]);
if (auth.response) {
  return auth.response;
}

const churchId = Astro.params.id;
if (!churchId) {
  return Astro.redirect("/admin/iglesias");
}

const [{ data: church }, { data: scheduleRows }] = await Promise.all([
  supabase.from("horarios_temples").select("*").eq("id", churchId).maybeSingle(),
  supabase
    .from("horarios_celebrations")
    .select("*")
    .eq("temple_id", churchId),
]);

if (!church) {
  return Astro.redirect("/admin/iglesias");
}

const schedules = (scheduleRows ?? [])
  .map((row) => scheduleRowToUi(row))
  .sort(
    (a, b) =>
      a.weekday - b.weekday || a.start_time.localeCompare(b.start_time),
  );

const canEdit = auth.session?.role === "admin" || auth.session?.role === "editor";
---

<AdminLayout title={`${church.name} | Fósforo Admin`} userEmail={auth.session?.email}>
  <section>
    <h1>{church.name}</h1>
    <p class="app-desc">{church.address}</p>
  </section>

  <section class="admin-section">
    <h2>Datos generales</h2>
    <div class="table-wrap">
      <table>
        <tbody>
          <tr><th>Ciudad</th><td>{church.city}</td></tr>
          <tr><th>Provincia</th><td>{church.province}</td></tr>
          <tr><th>País</th><td>{church.country ?? "-"}</td></tr>
          <tr>
            <th>Actualización</th>
            <td>
              <span class="status-pill" data-status={church.status}>{church.status}</span>
            </td>
          </tr>
          <tr>
            <th>Visible en Horarios de Misas</th>
            <td>
              <span class="status-pill" data-status={church.is_active ? "active" : "inactive"}>
                {church.is_active ? "Activa" : "Inactiva"}
              </span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="admin-section">
    <h2>Horarios</h2>
    {schedules.length > 0 ? (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Celebración</th>
              <th>Día</th>
              <th>Hora</th>
              <th>Duración</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody>
            {schedules.map((item) => (
              <tr>
                <td>{CELEBRATION_TYPE_LABELS[item.celebration_type as keyof typeof CELEBRATION_TYPE_LABELS] ?? item.celebration_type}</td>
                <td>{WEEKDAY_LABELS[item.weekday as keyof typeof WEEKDAY_LABELS]}</td>
                <td>{item.start_time}</td>
                <td>{item.duration_min} min</td>
                <td>{item.is_active ? "Activo" : "Inactivo"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="app-desc">Esta iglesia no tiene horarios registrados.</p>
    )}

    {canEdit && (
      <form class="form" method="post" action={`/api/churches/${churchId}/schedules`}>
        <h3>Agregar horario</h3>
        <div class="form-row">
          <label for="celebration_type">Celebración</label>
          <select id="celebration_type" name="celebration_type" required>
            {CELEBRATION_TYPES.map((type) => (
              <option value={type}>{CELEBRATION_TYPE_LABELS[type]}</option>
            ))}
          </select>
        </div>
        <div class="form-row">
          <label for="weekday">Día</label>
          <select id="weekday" name="weekday" required>
            {WEEKDAY_INDEXES.map((_, index) => (
              <option value={index}>{WEEKDAY_LABELS[index as keyof typeof WEEKDAY_LABELS]}</option>
            ))}
          </select>
        </div>
        <div class="form-row">
          <label for="start_time">Hora</label>
          <input id="start_time" name="start_time" type="time" required />
        </div>
        <div class="form-row">
          <label for="duration_min">Duración (minutos)</label>
          <input id="duration_min" name="duration_min" type="number" min="1" max="240" value="45" />
        </div>
        <button class="button-primary" type="submit">Guardar horario</button>
      </form>
    )}
  </section>
</AdminLayout>
