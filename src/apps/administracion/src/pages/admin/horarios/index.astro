---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { requirePageAuth } from "@/lib/auth";
import { supabase } from "@/db/supabase";

const auth = await requirePageAuth(Astro, ["admin", "editor", "viewer"]);
if (auth.response) {
  return auth.response;
}

const { data: schedules } = await supabase
  .from("horarios_celebrations")
  .select("id, type, weekday, start_time, temple_id")
  .order("updated_at", { ascending: false })
  .limit(80);

const templeIds = [
  ...new Set((schedules ?? []).map((row) => row.temple_id).filter(Boolean)),
];

let templeById = new Map<string, string>();
if (templeIds.length > 0) {
  const { data: temples } = await supabase
    .from("horarios_temples")
    .select("id, name")
    .in("id", templeIds);

  templeById = new Map(
    (temples ?? []).map((temple) => [temple.id as string, temple.name as string]),
  );
}
---

<AdminLayout title="Horarios | Fósforo Admin" userEmail={auth.session?.email}>
  <section>
    <h1>Horarios de celebraciones</h1>
    <p class="app-desc">Vista consolidada de horarios por iglesia.</p>
  </section>

  <section class="admin-section">
    {schedules && schedules.length > 0 ? (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Iglesia</th>
              <th>Celebración</th>
              <th>Día</th>
              <th>Hora</th>
            </tr>
          </thead>
          <tbody>
            {schedules.map((row) => (
              <tr>
                <td>{templeById.get(row.temple_id as string) ?? "-"}</td>
                <td>{row.type}</td>
                <td>{row.weekday}</td>
                <td>{row.start_time}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="app-desc">No hay horarios cargados todavía.</p>
    )}
  </section>
</AdminLayout>
