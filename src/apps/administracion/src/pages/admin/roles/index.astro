---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { requirePageAuth } from "@/lib/auth";
import { listRoles } from "@/lib/roles";

const auth = await requirePageAuth(Astro, ["admin", "editor", "viewer"]);
if (auth.response) {
  return auth.response;
}

const roles = await listRoles();
const canManage = auth.session?.role === "admin";
const formError = Astro.url.searchParams.get("error");

const messageByCode: Record<string, string> = {
  ADMIN_ROLE_DUPLICATED: "Ya existe un rol con ese slug.",
  ADMIN_ROLE_SLUG_RESERVED:
    "Ese slug está reservado por el sistema y no puede reutilizarse.",
  ADMIN_ROLE_CREATE_FAILED: "No se pudo crear el rol.",
  Validation: "Datos inválidos. Revisá el formulario.",
};
---

<AdminLayout title="Roles | Fósforo Admin" userEmail={auth.session?.email}>
  <section>
    <h1>Roles del ecosistema</h1>
    <p class="app-desc">Catálogo global de roles, jerarquía y adopción por aplicación.</p>
  </section>

  {formError && (
    <section class="admin-section">
      <div class="error-box">
        {messageByCode[formError] ?? "No se pudo completar la operación."}
      </div>
    </section>
  )}

  {canManage && (
    <section class="admin-section" aria-labelledby="role-create-title">
      <h2 id="role-create-title">Nuevo rol</h2>
      <form class="form" method="post" action="/api/roles">
        <div class="form-row">
          <label for="slug">Slug</label>
          <input id="slug" name="slug" required pattern="[a-z0-9-]{2,40}" />
        </div>
        <div class="form-row">
          <label for="name">Nombre</label>
          <input id="name" name="name" required minlength="2" maxlength="80" />
        </div>
        <div class="form-row">
          <label for="description">Descripción</label>
          <textarea id="description" name="description" maxlength="240"></textarea>
        </div>
        <div class="form-row">
          <label for="hierarchyLevel">Nivel de jerarquía (1 = más alto)</label>
          <input
            id="hierarchyLevel"
            name="hierarchyLevel"
            type="number"
            min="1"
            max="100"
            value="60"
            required
          />
        </div>
        <div class="actions-row">
          <button class="button-primary" type="submit">Crear rol</button>
        </div>
      </form>
    </section>
  )}

  <section class="admin-section" aria-labelledby="roles-list-title">
    <h2 id="roles-list-title">Catálogo</h2>
    {roles.length > 0 ? (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Slug</th>
              <th>Nombre</th>
              <th>Jerarquía</th>
              <th>Usuarios asignados</th>
              <th>Apps habilitadas</th>
            </tr>
          </thead>
          <tbody>
            {roles.map((role) => (
              <tr>
                <td>
                  <div class="chip-list">
                    <a href={`/admin/roles/${role.id}`}>{role.slug}</a>
                    {role.protected && (
                      <span class="status-pill" data-status="protected">protegido</span>
                    )}
                  </div>
                </td>
                <td>{role.name}</td>
                <td>{role.hierarchyLevel}</td>
                <td>{role.assignedUsers}</td>
                <td>{role.enabledApps}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="app-desc">No hay roles cargados.</p>
    )}
  </section>
</AdminLayout>
