---
import { getSessionFromRequest } from "@/lib/auth";
import "@/styles/global.css";

const existingSession = await getSessionFromRequest(Astro.request);
if (existingSession) {
  return Astro.redirect("/admin/dashboard");
}

const error = Astro.url.searchParams.get("error");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Ingresar | Fósforo Admin</title>
    <script is:inline>
      (() => {
        const theme = localStorage.getItem("fosforo-theme");
        document.documentElement.dataset.theme = theme === "light" ? "light" : "dark";
      })();
    </script>
  </head>
  <body class="admin-app">
    <main class="login-shell">
      <section class="login-card">
        <h1>Panel de administración</h1>
        <p class="app-desc">Ingresá con tu cuenta autorizada para operar en el ecosistema.</p>

        <form class="form" method="post" action="/api/auth/login">
          <div class="form-row">
            <label for="email">Correo</label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="form-row">
            <label for="password">Contraseña</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength="8"
              autocomplete="current-password"
            />
          </div>
          <button class="button-primary" type="submit">Ingresar</button>
          {error && <span class="form-status error">{error}</span>}
        </form>
      </section>
    </main>
  </body>
</html>
