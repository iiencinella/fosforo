---
import Head from "@/components/Head.astro";

type Props = {
  title: string;
  description?: string;
  image?: string;
};

const {
  title,
  description = "Cancionero del ecosistema Fósforo.",
  image,
} = Astro.props as Props;
---

<!doctype html>
<html lang="es">
  <Head title={title} description={description} image={image} />
  <body class="cancionero-theme">
    <div class="app-shell" transition:animate="fade">
      <slot />
    </div>
  </body>
</html>
