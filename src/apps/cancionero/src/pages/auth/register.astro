---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";

const session = Astro.locals.session;
const nextPath = Astro.url.searchParams.get("next") ?? "/";

if (session) {
  return Astro.redirect(nextPath);
}
---

<Layout
  title="Crear cuenta - Cancionero Fosforo"
  description="Registrate como musico en el Cancionero Fosforo para contribuir con canciones."
>
  <SiteHeader />

  <main class="cancionero-app">
    <section class="section" id="register">
      <div class="page cancionero-stack">
        <div class="cancionero-hero-copy">
          <span class="cancionero-kicker">Nueva cuenta</span>
          <h1 class="cancionero-title">Crea tu cuenta de musico.</h1>
          <p class="cancionero-subtitle">
            Al registrarte obtendras el rol <strong>musico</strong> que te
            permite contribuir nuevas canciones al cancionero. La
            administracion aprueba cada aporte antes de publicarlo.
          </p>
        </div>

        <article class="card surface-card cancionero-auth-card">
          <h2 class="card-title">Datos de la cuenta</h2>
          <form id="register-form" class="cancionero-form" novalidate>
            <label class="form-row">
              <span>Nombre completo</span>
              <input
                id="register-name"
                name="name"
                autocomplete="name"
                required
                minlength="2"
                maxlength="80"
              />
            </label>
            <label class="form-row">
              <span>Email</span>
              <input
                id="register-email"
                name="email"
                type="email"
                autocomplete="email"
                required
              />
            </label>
            <label class="form-row">
              <span>Contrasena</span>
              <input
                id="register-password"
                name="password"
                type="password"
                autocomplete="new-password"
                minlength="8"
                maxlength="72"
                required
              />
              <small class="cancionero-form-hint">Minimo 8 caracteres.</small>
            </label>
            <div class="cancionero-filter-actions">
              <button class="button" type="submit">Crear cuenta</button>
              <a class="button secondary" href={`/auth/login${nextPath === "/" ? "" : `?next=${encodeURIComponent(nextPath)}`}`}>
                Ya tengo cuenta
              </a>
            </div>
            <p id="register-status" class="form-status pending" role="status" aria-live="polite">
              Completa tus datos para continuar.
            </p>
          </form>
        </article>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<script>
  const form = document.querySelector("#register-form") as HTMLFormElement | null;
  const status = document.querySelector("#register-status") as HTMLParagraphElement | null;
  const nextPath = new URL(window.location.href).searchParams.get("next") ?? "/";

  if (form && status) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const payload = {
        name: String(formData.get("name") || "").trim(),
        email: String(formData.get("email") || "").trim(),
        password: String(formData.get("password") || "").trim(),
      };

      status.className = "form-status pending";
      status.textContent = "Creando cuenta...";

      try {
        const response = await fetch("/api/cancionero/auth/register", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await response.json();
        if (!response.ok || !data.ok) {
          throw new Error(data.error || "CANCIONERO_REGISTER_FAILED");
        }

        status.className = "form-status success";
        status.textContent = "Cuenta creada. Ahora podes iniciar sesion.";
        window.setTimeout(() => {
          window.location.href = `/auth/login${nextPath === "/" ? "" : `?next=${encodeURIComponent(nextPath)}`}`;
        }, 600);
      } catch (error) {
        const message = error instanceof Error ? error.message : "CANCIONERO_REGISTER_FAILED";
        status.className = "form-status error";
        status.textContent = `No pudimos crear la cuenta (${message}).`;
      }
    });
  }
</script>
