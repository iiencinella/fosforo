# Supabase (required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional aliases used by shared env readers
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_KEY=

# Optional integration with calendario app
# Example: http://localhost:4321 or https://calendario.fosforo.org
CALENDARIO_API_URL=

# Logs API (optional, para enviar logs al app log del ecosistema)
LOGS_API_URL=http://localhost:4321/api/logs
LOGS_API_KEY=fosforo-cancionero-dev-key-2026
