---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { getCollection } from "astro:content";
import { PortalBlogCard } from "@repo/ui";
import blogPostDefault from "@/assets/blog_post_default.png";

function summarizeBody(markdown: string): string {
  const normalized = markdown
    .replace(/[#*_`>\-]/g, " ")
    .replace(/\s+/g, " ")
    .trim();

  if (normalized.length <= 160) {
    return normalized;
  }

  return `${normalized.slice(0, 157).trim()}...`;
}

const novedades = (await getCollection("novedades"))
  .sort(
    (a, b) =>
      b.data.fecha_creación.getTime() - a.data.fecha_creación.getTime(),
  )
  .map((item) => ({
    slug: item.data.slug,
    title: item.data.titulo,
    description: summarizeBody(item.body ?? ""),
    createdAt: item.data.fecha_creación.toISOString().slice(0, 10),
    date: item.data.fecha_creación.toISOString().slice(0, 10),
    category: "novedad",
    app: "portal",
    href: `/novedades/${item.data.slug}`,
    imageSrc: item.data.image?.src ?? blogPostDefault.src,
    imageAlt: `Imagen de portada para ${item.data.titulo}`,
  }));
---

<BaseLayout title="Novedades · Portal Fósforo" description="Novedades del ecosistema Fósforo.">
  <SiteHeader />
  <main class="section">
    <div class="page">
      <h1 class="section-title">Novedades</h1>
      <p class="section-desc">
        Publicaciónes manuales versionadas desde el contenido del portal.
      </p>

      {
        novedades.length > 0 ? (
          <>
            <div class="card-grid blog-grid mt-24" data-novedades-grid>
              {novedades.map((item) => (
                <div data-release-date={item.createdAt}>
                  <PortalBlogCard {...item} />
                </div>
              ))}
            </div>
            <article class="card mt-24" data-novedades-empty hidden>
              <h2 class="card-title">Todavía no hay novedades publicadas</h2>
              <p class="app-desc">
                Cuando haya posteos con fecha igual o anterior a tu fecha actual, aparecerán en
                esta sección.
              </p>
            </article>
          </>
        ) : (
          <article class="card mt-24">
            <h2 class="card-title">Todavía no hay novedades publicadas</h2>
            <p class="app-desc">Cuando se publique contenido, aparecerá en esta sección.</p>
          </article>
        )
      }
    </div>
  </main>
  {
    novedades.length > 0 ? (
      <script is:inline>
        (() => {
          const grid = document.querySelector("[data-novedades-grid]");
          const emptyState = document.querySelector("[data-novedades-empty]");

          if (!(grid instanceof HTMLElement) || !(emptyState instanceof HTMLElement)) {
            return;
          }

          const today = new Date();
          const userDate = new Date(today.getFullYear(), today.getMonth(), today.getDate());
          const postElements = Array.from(grid.querySelectorAll("[data-release-date]"));

          let visiblePosts = 0;

          postElements.forEach((postElement) => {
            if (!(postElement instanceof HTMLElement)) {
              return;
            }

            const releaseDateRaw = postElement.dataset.releaseDate;
            const releaseDate = releaseDateRaw ? new Date(`${releaseDateRaw}T00:00:00`) : null;
            const shouldShow =
              releaseDate instanceof Date &&
              Number.isFinite(releaseDate.getTime()) &&
              releaseDate.getTime() <= userDate.getTime();

            postElement.hidden = !shouldShow;

            if (shouldShow) {
              visiblePosts += 1;
            }
          });

          const hasVisiblePosts = visiblePosts > 0;

          grid.hidden = !hasVisiblePosts;
          emptyState.hidden = hasVisiblePosts;
        })();
      </script>
    ) : null
  }
  <SiteFooter />
</BaseLayout>
