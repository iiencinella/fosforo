---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import AccessDeniedCard from "@/components/AccessDeniedCard.astro";
import AlertBanner from "@/components/AlertBanner.astro";
import { getAccessTokenFromRequest } from "@/lib/auth";
import { getSessionFromToken } from "@/lib/auth-supabase";
import { createLogRepository } from "@/lib/log-repository";
import { type LogLevel, type LogEntry } from "@/lib/log-data";

const token = getAccessTokenFromRequest(Astro.request);
let role: "dev" | "ops" | null = null;

if (token) {
  try {
    const session = await getSessionFromToken(token);
    role = session.role;
  } catch {
    role = null;
  }
}

const canAccess = role === "dev" || role === "ops";

const searchParams = Astro.url.searchParams;
const levelParam = searchParams.get("level") as LogLevel | null;
const appParam = searchParams.get("app") ?? "";
const searchParam = searchParams.get("search") ?? "";
const sinceParam = searchParams.get("since") ?? "";
const untilParam = searchParams.get("until") ?? "";
const pageParam = Number.parseInt(searchParams.get("page") ?? "1", 10);
const limitParam = Number.parseInt(searchParams.get("limit") ?? "50", 10);

const currentPage = Number.isNaN(pageParam) ? 1 : Math.max(1, pageParam);
const currentLimit =
  Number.isNaN(limitParam) || ![10, 20, 50].includes(limitParam)
    ? 50
    : limitParam;

type ListResult = {
  data: LogEntry[];
  total: number;
  page: number;
  limit: number;
};

let result: ListResult | null = null;
let metrics: {
  totalLogs: number;
  errorCount24h: number;
  errorRate: number;
  topApps: Array<{ app: string; count: number }>;
} | null = null;
let alerts: {
  threshold: number;
  triggered: Array<{ app: string; count: number }>;
} | null = null;
let loadError: string | null = null;

if (canAccess) {
  const repository = createLogRepository();
  try {
    const [listResult, metricsResult] = await Promise.all([
      repository.list({
        page: currentPage,
        limit: currentLimit,
        level: levelParam ?? undefined,
        app: appParam || undefined,
        search: searchParam || undefined,
        since: sinceParam || undefined,
        until: untilParam || undefined,
      }),
      repository.metrics(),
    ]);
    result = listResult;
    metrics = metricsResult.metrics;
    alerts = metricsResult.alerts;
  } catch (error) {
    loadError = String(error);
  }
}

function buildPageUrl(page: number) {
  const params = new URLSearchParams();
  if (searchParam) params.set("search", searchParam);
  if (levelParam) params.set("level", levelParam);
  if (appParam) params.set("app", appParam);
  if (sinceParam) params.set("since", sinceParam);
  if (untilParam) params.set("until", untilParam);
  if (currentLimit !== 50) params.set("limit", String(currentLimit));
  if (page > 1) params.set("page", String(page));
  const query = params.toString();
  return query ? `/logs?${query}` : "/logs";
}

const totalPages = result ? Math.max(1, Math.ceil(result.total / result.limit)) : 1;
const hasPrev = (result?.page ?? 1) > 1;
const hasNext = (result?.page ?? 1) < totalPages;

const knownApps = [
  ...new Set(
    [
      ...(result?.data.map((item) => item.app) ?? []),
      ...(metrics?.topApps.map((item) => item.app) ?? []),
    ],
  ),
].sort((a, b) => a.localeCompare(b));

function levelClass(level: LogLevel) {
  return `log-level log-level--${level}`;
}
---

<BaseLayout title="Logs · Fosforo Log" description="Listado de eventos del ecosistema Fosforo.">
  <SiteHeader />

  <main id="main-content" class="page log-main">
    {
      !canAccess ? (
        <AccessDeniedCard />
      ) : loadError ? (
        <>
          <section class="log-hero">
            <p class="log-hero__kicker">Observabilidad centralizada</p>
            <h1 class="log-hero__title">Logs del ecosistema</h1>
          </section>
          <section class="surface-card" role="alert">
            <h2 class="card-title">No se pudieron cargar los logs</h2>
            <p class="app-desc">
              Ocurrio un error al consultar la base de datos. Verifica tu conexion e intenta nuevamente.
            </p>
            <p class="form-status error">Detalle tecnico: {loadError}</p>
            <a class="button" href={Astro.url.pathname + (Astro.url.search ?? "")}>
              Reintentar
            </a>
          </section>
        </>
      ) : result && metrics && alerts ? (
        <>
          <section class="log-hero">
            <p class="log-hero__kicker">Observabilidad centralizada</p>
            <h1 class="log-hero__title">Logs del ecosistema</h1>
            <p class="log-hero__subtitle">
              Explora errores, advertencias y eventos por aplicacion, severidad y texto libre.
            </p>
          </section>

          <AlertBanner triggered={alerts.triggered} threshold={alerts.threshold} />

          <section class="surface-grid" aria-label="Metricas resumen">
            <article class="surface-card surface-card--metric">
              <p class="surface-card__label">Total logs</p>
              <p class="surface-card__value">{metrics.totalLogs}</p>
              <p class="surface-card__meta">Acumulado del entorno actual</p>
            </article>
            <article class="surface-card surface-card--metric">
              <p class="surface-card__label">Errores 24h</p>
              <p class="surface-card__value">{metrics.errorCount24h}</p>
              <p class="surface-card__meta">Error + fatal en ventana movil</p>
            </article>
            <article class="surface-card surface-card--metric">
              <p class="surface-card__label">Error rate</p>
              <p class="surface-card__value">{metrics.errorRate.toFixed(1)}%</p>
              <p class="surface-card__meta">Sobre total de eventos</p>
            </article>
            <article class="surface-card surface-card--metric">
              <p class="surface-card__label">Top app</p>
              <p class="surface-card__value">{metrics.topApps[0]?.app ?? "-"}</p>
              <p class="surface-card__meta">Mayor volumen registrado</p>
            </article>
          </section>

          <section class="surface-card">
            <form class="log-filters" method="get" action="/logs" data-log-filters>
              <div class="form-row form-row--search">
                <label for="search">Busqueda</label>
                <input
                  id="search"
                  name="search"
                  type="search"
                  value={searchParam}
                  placeholder="timeout, 500, endpoint..."
                />
              </div>

              <div class="form-row form-row--level">
                <label for="level">Nivel</label>
                <select id="level" name="level">
                  <option value="">Todos</option>
                  <option value="debug" selected={levelParam === "debug"}>debug</option>
                  <option value="info" selected={levelParam === "info"}>info</option>
                  <option value="warn" selected={levelParam === "warn"}>warn</option>
                  <option value="error" selected={levelParam === "error"}>error</option>
                  <option value="fatal" selected={levelParam === "fatal"}>fatal</option>
                </select>
              </div>

              <div class="form-row form-row--app">
                <label for="app">App</label>
                <select id="app" name="app">
                  <option value="">Todas</option>
                  {knownApps.map((app) => <option value={app} selected={appParam === app}>{app}</option>)}
                </select>
              </div>

              <div class="form-row form-row--date">
                <label for="since">Desde</label>
                <input id="since" name="since" type="datetime-local" value={sinceParam} />
              </div>

              <div class="form-row form-row--date">
                <label for="until">Hasta</label>
                <input id="until" name="until" type="datetime-local" value={untilParam} />
              </div>

              <div class="form-row form-row--limit">
                <label for="limit">Limite</label>
                <select id="limit" name="limit">
                  <option value="10" selected={result.limit === 10}>10</option>
                  <option value="20" selected={result.limit === 20}>20</option>
                  <option value="50" selected={result.limit === 50}>50</option>
                </select>
              </div>

              <div class="form-row form-row--submit">
                <button class="button" type="submit">Filtrar</button>
              </div>
            </form>
          </section>

          <section class="surface-card">
            <div class="log-table-wrap" data-log-table aria-busy="false">
              <div class="log-table-skeleton" data-log-skeleton hidden aria-hidden="true">
                {Array.from({ length: 5 }).map(() => (
                  <div class="skeleton-pulse skeleton-bar" />
                ))}
              </div>
              {result.data.length > 0 ? (
                <table class="log-table">
                  <thead>
                    <tr>
                      <th>Timestamp</th>
                      <th>App</th>
                      <th>Nivel</th>
                      <th>Mensaje</th>
                      <th>Detalle</th>
                    </tr>
                  </thead>
                  <tbody>
                    {result.data.map((item) => (
                      <tr>
                        <td>{new Date(item.timestamp).toLocaleString("es-AR")}</td>
                        <td>{item.app}</td>
                        <td>
                          <span class={levelClass(item.level)}>{item.level}</span>
                        </td>
                        <td class="log-row-message">{item.message}</td>
                        <td>
                          <a class="button secondary" href={`/logs/${item.id}`}>Ver</a>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : (
                <article aria-live="polite">
                  <h2 class="card-title">Sin resultados</h2>
                  <p class="app-desc">No hay logs que coincidan con los filtros aplicados.</p>
                </article>
              )}
            </div>

            <nav class="pagination" aria-label="Paginacion de logs">
              <span class="pagination__status">
                Pagina {result.page} de {totalPages} · {result.total} logs
              </span>
              <div class="inline-actions">
                {hasPrev ? (
                  <a class="button secondary" href={buildPageUrl(result.page - 1)} rel="prev">
                    Anterior
                  </a>
                ) : (
                  <button class="button secondary" disabled>Anterior</button>
                )}
                {hasNext ? (
                  <a class="button secondary" href={buildPageUrl(result.page + 1)} rel="next">
                    Siguiente
                  </a>
                ) : (
                  <button class="button secondary" disabled>Siguiente</button>
                )}
              </div>
            </nav>
          </section>

          <script>
            document.querySelectorAll<HTMLFormElement>("[data-log-filters]").forEach((form) => {
              form.addEventListener("submit", () => {
                const table = document.querySelector("[data-log-table]");
                const skeleton = document.querySelector("[data-log-skeleton]");
                if (table && skeleton) {
                  table.setAttribute("aria-busy", "true");
                  skeleton.removeAttribute("hidden");
                }
              });
            });
          </script>
        </>
      ) : null
    }
  </main>

  <SiteFooter />
</BaseLayout>
