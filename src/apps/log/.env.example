# Fósforo - Environment Variables
# Copy this file to .env and fill in the values.
# These variables are shared across all apps via Vite envDir.

# Supabase (required for auth app and any DB-connected features)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Optional: separate key alias used by some modules
SUPABASE_KEY=

# Logs ingest API key (optional, falls back to SUPABASE_SERVICE_ROLE_KEY)
LOGS_INGEST_API_KEY=
