---
// FormField — campo de formulario accesible (label + input + ayuda/error)
// para paneles del ecosistema. type soporta los tipos de input nativos;
// as="textarea" para campos multilinea (ej. Markdown).
type Props = {
  label: string;
  name: string;
  id?: string;
  type?: string;
  as?: "input" | "textarea";
  value?: string | number;
  required?: boolean;
  placeholder?: string;
  helpText?: string;
  error?: string;
  autocomplete?: string;
  minlength?: number;
  maxlength?: number;
  rows?: number;
};

const {
  label,
  name,
  id = name,
  type = "text",
  as = "input",
  value,
  required = false,
  placeholder,
  helpText,
  error,
  autocomplete,
  minlength,
  maxlength,
  rows = 6,
} = Astro.props as Props;

const describedBy = [helpText ? `${id}-help` : null, error ? `${id}-error` : null]
  .filter(Boolean)
  .join(" ") || undefined;
---

<div class:list={["cms-form-field", error && "cms-form-field--error"]}>
  <label for={id}>
    {label}
    {required && <span aria-hidden="true"> *</span>}
  </label>

  {
    as === "textarea" ? (
      <textarea
        id={id}
        name={name}
        rows={rows}
        required={required}
        placeholder={placeholder}
        aria-describedby={describedBy}
        aria-invalid={error ? "true" : undefined}
      >
        {value}
      </textarea>
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        value={value}
        required={required}
        placeholder={placeholder}
        autocomplete={autocomplete}
        minlength={minlength}
        maxlength={maxlength}
        aria-describedby={describedBy}
        aria-invalid={error ? "true" : undefined}
      />
    )
  }

  {
    helpText && (
      <p class="cms-form-field__help" id={`${id}-help`}>
        {helpText}
      </p>
    )
  }
  {
    error && (
      <p class="cms-form-field__error" id={`${id}-error`} role="alert">
        {error}
      </p>
    )
  }
</div>

<style>
  .cms-form-field {
    display: grid;
    gap: var(--spacing-1, 0.25rem);
  }

  .cms-form-field label {
    font-size: var(--text-sm, 0.875rem);
    font-weight: 600;
  }

  .cms-form-field input,
  .cms-form-field textarea {
    padding: var(--spacing-2, 0.5rem) var(--spacing-3, 0.75rem);
    border: 1px solid var(--color-line, #e0e0e0);
    border-radius: var(--radius-md, 0.375rem);
    background: var(--color-bg-elevated, #fff);
    color: var(--color-text, #111);
    font: inherit;
  }

  .cms-form-field--error input,
  .cms-form-field--error textarea {
    border-color: var(--color-danger, #b3261e);
  }

  .cms-form-field__help {
    color: var(--color-text-muted, #666);
    font-size: var(--text-xs, 0.75rem);
  }

  .cms-form-field__error {
    color: var(--color-danger, #b3261e);
    font-size: var(--text-xs, 0.75rem);
  }
</style>
