{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/*.css",
    "src/astro/*.astro"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/index.css",
    "./foundation.css": "./src/foundation.css",
    "./bible-modules.css": "./src/bible-modules.css",
    "./developer-surfaces.css": "./src/developer-surfaces.css",
    "./team-member-avatar.css": "./src/team-member-avatar.css",
    "./catalog.css": "./src/catalog.css",
    "./skeleton.css": "./src/skeleton.css",
    "./overlays.css": "./src/overlays.css",
    "./astro/ApiLinkList.astro": "./src/astro/ApiLinkList.astro",
    "./astro/CatalogLinkCard.astro": "./src/astro/CatalogLinkCard.astro",
    "./astro/CatalogOverlayCard.astro": "./src/astro/CatalogOverlayCard.astro",
    "./astro/CatalogHero.astro": "./src/astro/CatalogHero.astro",
    "./astro/CatalogFilters.astro": "./src/astro/CatalogFilters.astro",
    "./astro/CatalogResults.astro": "./src/astro/CatalogResults.astro",
    "./astro/CatalogEmptyState.astro": "./src/astro/CatalogEmptyState.astro",
    "./astro/CatalogPagination.astro": "./src/astro/CatalogPagination.astro",
    "./astro/SectionIntro.astro": "./src/astro/SectionIntro.astro",
    "./astro/ActionLinkList.astro": "./src/astro/ActionLinkList.astro",
    "./astro/ButtonLink.astro": "./src/astro/ButtonLink.astro",
    "./astro/EcosystemFooter.astro": "./src/astro/EcosystemFooter.astro",
    "./astro/InfoPanel.astro": "./src/astro/InfoPanel.astro",
    "./astro/MetricGrid.astro": "./src/astro/MetricGrid.astro",
    "./astro/Tabs.astro": "./src/astro/Tabs.astro",
    "./tabs.css": "./src/tabs.css",
    "./portal.css": "./src/portal.css",
    "./calendar.css": "./src/calendar.css",
    "./*": "./dist/*.js"
  },
  "license": "MIT",
  "scripts": {
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "build:components": "tsc",
    "check-types": "tsc --noEmit",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev:components": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "peerDependencies": {
    "react": "19"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/cli": "catalog:",
    "@types/react": "catalog:",
    "eslint": "10.9.0",
    "mri": "^1.2.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
